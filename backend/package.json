{
  "name": "filament-tracker-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/worker.ts",
    "test:run": "vitest run",
    "build:frontend": "npm --prefix ../frontend run build",
    "deploy": "npm run build:frontend && wrangler deploy --keep-vars",
    "db:migrate": "wrangler d1 migrations apply filament-tracker"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261121.1",
    "typescript": "5.9.3",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  }
}
